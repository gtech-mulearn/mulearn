{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
    "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"], 
            "@/modules/*": ["./src/modules/*"],
            "@/MuLearnComponents/*": ["./src/components/MuComponents/*"],
            "@/MuLearnServices/*": ["./src/services/*"],
            "@/src/*": ["./src/*"],
        }
    },
    "include": ["src", "src/**/*"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
